// PROPERTYNEX — Prisma schema (PostgreSQL / Vercel Postgres)
//
// Architectural notes:
// - Migrated to PostgreSQL for native Vercel Postgres / Neon integration.
// - Uses CUIDs for unique, URL-safe identifiers.
// - Passwords and OTP passcodes are stored as secure hashes (bcrypt / HMAC).
// - Session and PasswordResetSession maintain strict token segregation.
// - Native PostgreSQL array and enum support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  USER
  OWNER
  AGENT
  BUILDER
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  PENDING_VERIFICATION
  VERIFIED
}

enum ListingType {
  BUY
  RENT
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  BUILDER_FLOOR
  PENTHOUSE
  STUDIO
  PLOT
  FARMHOUSE
  PG_HOSTEL
  OFFICE
  SHOP
  SHOWROOM
  WAREHOUSE
  COMMERCIAL_LAND
}

enum AreaUnit {
  SQFT
  SQM
  SQYD
  ACRE
  HECTARE
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum ParkingType {
  NONE
  OPEN
  COVERED
  BOTH
}

enum ContactPreference {
  PHONE
  EMAIL
  BOTH
  IN_APP
}

/// How precisely a listing's coordinates may be published on a public map.
///
/// `APPROXIMATE` is the default, and deliberately so: every row that existed
/// before this enum was added has coordinates its owner supplied for internal
/// use, never for publication on a map. Defaulting to EXACT would retroactively
/// publish the door of every listing already in the table, which is a consent
/// decision the migration is not entitled to make on an owner's behalf.
///
/// `APPROXIMATE` does not fabricate a position — `lib/properties/location.ts`
/// rounds the real coordinate to a coarser grid, and the UI labels it as
/// approximate. The exact value stays in the row for the owner's own use.
enum LocationPrecision {
  EXACT
  APPROXIMATE
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
}

enum MediaKind {
  IMAGE
  FLOOR_PLAN
  VIDEO
  TOUR_360
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  phone        String @unique
  passwordHash String

  role  Role    @default(USER)
  image String?

  phoneDigits String?

  securityQuestionId Int?
  securityAnswerHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions              Session[]
  passwordResetSessions PasswordResetSession[]
  properties            Property[]
  favorites             Favorite[]

  @@index([phoneDigits])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetSession {
  id        String  @id @default(cuid())
  tokenHash String  @unique
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel           String
  destinationMasked String

  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  resendCount  Int       @default(0)
  lastSentAt   DateTime

  stage     String   @default("OTP_PENDING")
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_sessions")
}

model Property {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title        String
  description  String
  propertyType PropertyType
  listingType  ListingType

  price      Float
  negotiable Boolean @default(false)

  areaValue Float
  areaUnit  AreaUnit @default(SQFT)

  bedrooms    Int?
  bathrooms   Int?
  floor       Int?
  totalFloors Int?

  furnishing       Furnishing?
  parking          ParkingType?
  propertyAgeYears Int?

  amenities String[]

  addressLine1 String
  addressLine2 String?
  locality     String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")

  mapsUrl   String?
  latitude  Float?
  longitude Float?

  /// Gates how precisely `latitude`/`longitude` reach a public map. Safe by
  /// default — see the enum's own note.
  locationPrecision LocationPrecision @default(APPROXIMATE)

  contactPreference ContactPreference @default(BOTH)

  status      PropertyStatus @default(DRAFT)
  publishedAt DateTime?

  verificationRequestedAt DateTime?
  verifiedAt              DateTime?
  verifiedById            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiries PropertyInquiry[]
  media     PropertyMedia[]
  favorites Favorite[]

  @@index([ownerId, status])
  @@index([ownerId, createdAt])
  @@index([status, listingType])
  @@index([status, propertyType])
  @@index([status, city])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, publishedAt])
  @@map("properties")
}

model PropertyInquiry {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ownerId String

  fromUserId String?

  name    String
  email   String
  phone   String?
  message String

  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([propertyId, createdAt])
  @@index([ownerId, status])
  @@index([fromUserId])
  @@map("property_inquiries")
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ownerId String

  kind MediaKind @default(IMAGE)

  storageDriver String
  storageKey    String

  mimeType String
  byteSize Int

  width  Int?
  height Int?

  checksum String

  alt String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, kind, sortOrder])
  @@index([propertyId, checksum])
  @@index([ownerId])
  @@map("property_media")
}

model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId, createdAt])
  @@index([propertyId])
  @@map("favorites")
}
