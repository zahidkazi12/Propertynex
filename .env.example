# ─────────────────────────────────────────────────────────────
# PROPERTYNEX — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string.
# Local:  mongodb://localhost:27017/propertynex?replicaSet=rs0
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/propertynex?retryWrites=true&w=majority
# Prisma's MongoDB connector requires the database to run as a replica set
# (Atlas clusters already are one; see README for local single-node setup).
DATABASE_URL="mongodb://localhost:27017/propertynex?replicaSet=rs0"

# Used to sign/verify session cookies.
# Generate a strong random value, e.g.: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-secret"

# Public app URL (used for building absolute links, cookie settings, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Separate secret used specifically for password-reset session tokens,
# so a leak of one secret does not compromise the other.
PASSWORD_RESET_SECRET="replace-with-a-secure-reset-secret"

# Keys the HMAC that one-time passcodes are stored under. REQUIRED — there is
# deliberately NO fallback to another secret.
#
# A 6-digit code has only a million possible values, so an unkeyed hash of one is
# trivially reversible; this secret is what makes a database leak insufficient to
# recover a live passcode. It must be a DISTINCT value from AUTH_SECRET and
# PASSWORD_RESET_SECRET: sharing one would mean a single leak compromised session
# cookies, recovery tokens and passcode digests all at once, instead of one of them.
#
# Minimum 16 characters; the app refuses to issue or verify a passcode without it.
OTP_SECRET="replace-with-a-third-secure-random-secret"

# ─────────────────────────────────────────────────────────────
# OTP DELIVERY PROVIDERS
#
# Password recovery sends a one-time passcode to the email address or mobile
# number on the account. Which service actually delivers it is configured here
# and nowhere else — no credential is hard-coded, and none has a default.
#
# Resolution is fail-closed: if a channel has no provider configured, the
# recovery endpoint returns a generic "temporarily unavailable" error rather
# than pretending the code was sent. See lib/otp/providers/index.ts.
# ─────────────────────────────────────────────────────────────

# ── Email channel ───────────────────────────────────────────
# OTP_EMAIL_PROVIDER = console | resend
#   console : development only — prints the passcode to the server console.
#             Refuses to run with NODE_ENV=production.
#   resend  : real delivery via the Resend HTTP API (no SDK dependency).
# Unset in development defaults to `console`; unset in production is an error.
OTP_EMAIL_PROVIDER="console"

# Required when OTP_EMAIL_PROVIDER=resend
# RESEND_API_KEY="re_..."
# OTP_EMAIL_FROM="PROPERTYNEX <no-reply@yourdomain.com>"

# ── SMS channel ─────────────────────────────────────────────
# OTP_SMS_PROVIDER = console | twilio
OTP_SMS_PROVIDER="console"

# Required when OTP_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# OTP_SMS_FROM="+15550000000"

# Set to "false" to stop the development console provider from printing
# passcodes (useful for exercising the delivery-failure path locally).
# Has no effect in production, where that provider cannot be selected at all.
# OTP_DEV_LOG_CODES="true"

# ─────────────────────────────────────────────────────────────
# PROPERTY MEDIA STORAGE
#
# Where uploaded property photos are written. The application never builds a URL
# from any of this: a stored file is only ever addressed as /api/media/<id>, which
# resolves the row, checks who may see it, and streams the bytes. So changing the
# driver changes nothing a browser sees, and no internal path is ever published.
#
# Resolution is fail-closed, the same posture as the OTP providers above: an
# unrecognised driver name is an error at startup, not a silent fall back to the
# local disk. A deployment that believed it was writing to a bucket while actually
# writing to an ephemeral container filesystem would lose every photo on the next
# restart, quietly. See lib/media/storage/index.ts.
# ─────────────────────────────────────────────────────────────

# MEDIA_STORAGE_DRIVER = local
#   local : the server's own filesystem, under MEDIA_STORAGE_DIR.
#
# `local` is the only driver implemented, and it is genuinely correct for a
# single-instance deployment. It is NOT correct for a horizontally scaled or
# serverless one: each instance would hold a different subset of the photos, and a
# container's disk does not survive a restart. Adding S3, R2 or similar is an
# implementation of the three-method MediaStorage interface plus a case in
# resolveDriver() — no route, no component and no database column changes.
#
# Credentials for such a driver belong here, as environment variables, and nowhere
# else. Nothing in the codebase reads a key or a bucket name from anywhere but
# process.env.
MEDIA_STORAGE_DRIVER="local"

# Root directory for the `local` driver. Relative paths resolve from the project
# root; the directory is created on first upload.
#
# Deliberately NOT inside public/ — anything there is served by the static handler,
# which runs no access check, so an unpublished listing's photos would be
# world-readable the moment they were uploaded. Defaults to .media-storage, which
# is in .gitignore.
MEDIA_STORAGE_DIR=".media-storage"

# Upload limits (accepted formats, per-file size, per-listing count) are NOT
# configurable here, for the same reason the passcode policy is not: they are the
# validation boundary, not deployment config. They live in lib/media/constants.ts.

# ─────────────────────────────────────────────────────────────
# Password recovery is OTP-based. There is intentionally no security-question
# configuration here: security answers are low-entropy, often discoverable from
# public information, and prove nothing about present control of the contact
# address an account is registered to. The legacy User.securityQuestionId /
# securityAnswerHash columns survive as optional fields for existing rows only
# and are not read by any flow — see lib/auth/security-questions.ts.
#
# Passcode policy (TTL, cooldown, attempt and resend caps) is deliberately NOT
# environment-configurable — it is security policy, not deployment config, and
# lives in lib/otp/config.ts.
# ─────────────────────────────────────────────────────────────
